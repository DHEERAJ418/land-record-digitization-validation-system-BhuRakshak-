# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bhurakshak

# Optional tuning
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_RETRY_DELAY_MS=3000

# Leave false in normal use. If true, ALL application collections are cleared at startup.
RESET_MONGODB_ON_START=false

PORT=3000

# Shared officer credentials for the hackathon demo
OFFICER_USER_ID=DHEE14
OFFICER_PASSWORD=New@1234

# Optional public URL for QR codes. Leave blank to encode verification details directly in the QR.
PUBLIC_BASE_URL=
